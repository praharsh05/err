# Delete the transport CA and per-node transport cert secrets
kubectl delete secret elasticsearch-es-transport-ca-internal -n elasticsearch
kubectl delete secret elasticsearch-es-master-es-transport-certs -n elasticsearch
kubectl delete secret elasticsearch-es-data-es-transport-certs -n elasticsearch


kubectl rollout restart statefulset elasticsearch-es-master -n elasticsearch
kubectl rollout restart statefulset elasticsearch-es-data -n elasticsearch


kubectl exec -n elasticsearch elasticsearch-es-master-0 -- date
kubectl exec -n elasticsearch elasticsearch-es-master-1 -- date
kubectl exec -n elasticsearch elasticsearch-es-master-2 -- date
curl -k http://172.16.123.228/api/v1/did-numbers/byNumber
